{
  "name": "presh-web",
  "private": true,
  "version": "0.1.0",
  "description": "Torchless web app: rig control over Web Bluetooth, plus the shared bench.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bench": "tsc -p tsconfig.json && node dist/bench/run.js",
    "page": "esbuild src/web/test-page.ts --bundle --format=iife --target=safari15,chrome100 --outfile=public/test/app.js",
    "app": "esbuild src/web/app.ts --bundle --format=iife --target=safari15,chrome100 --minify --define:__PEAK__=false --loader:.worklet=text --outfile=public/app.js",
    "peak": "esbuild src/web/app.ts --bundle --format=iife --target=safari15,chrome100 --minify --define:__PEAK__=true --loader:.worklet=text --outfile=public/peak/app.js && node scripts/peak-page.js",
    "bench:peak": "tsc -p tsconfig.json && node dist/bench/peak-run.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@supabase/auth-js": "^2.119.0",
    "@supabase/postgrest-js": "^2.119.0"
  }
}
