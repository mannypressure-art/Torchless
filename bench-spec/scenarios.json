{
 "version": 1,
 "about": "The 33 rig scenarios every Presh version (Swift iPhone, web, Android) must pass before release. Ported from switch app/sim-bench/harness/main.swift as run on RigController.swift md5 5397d39849aa6890ec0a7eeadae91025, BLEManager 6a69fac9afbc8c2c86f9f8f476e3c60a, FrameDecoder 2f9b5bcb9bd9b76c2403ec9b7c11bd60 (33 of 33 passed). Times are seconds from the start of the scenario. Rules use the vocabulary in VOCAB.md; the simulated rig is in SIMRIG.md. Each port prints 'PASS <title>' or 'FAIL <title>: n problem(s)' with the title exactly as written here.",
 "defaults": {
  "connect": "scan at 0.2 s, tap the first rig found at 0.6 s",
  "allowedAppStarts": 0,
  "show": false
 },
 "invariants": [
  {
   "expect": "only known-safe commands were ever sent (never reset, rename, firmware)",
   "rule": "received.every(f => [177,178,179,181,183,185].includes(f.bytes[0]))"
  },
  {
   "expect": "every control frame is well formed",
   "rule": "b9s.every(f => f.bytes.length == 20 && f.bytes[1] == 20 && f.bytes[19] == 185)"
  },
  {
   "expect": "app started heat as often as the scenario allows",
   "rule": "appStarts == allowedAppStarts"
  },
  {
   "expect": "writes are spaced out (at least 85 ms apart)",
   "rule": "minGapBetweenReceived >= 0.085"
  },
  {
   "expect": "mid-session writes all sent right after a status frame",
   "rule": "b9s.filter(f => f.bytes[10] == 170 && f.sessionWas != 0).every(f => f.sinceStatus <= 0.3)"
  },
  {
   "expect": "rig saw nothing malformed",
   "rule": "events.count('BAD') == 0 && events.count('UNEXPECTED') == 0"
  }
 ],
 "scenarios": [
  {
   "id": "basic",
   "title": "basic: connect, HEAT IT, CUT IT",
   "allowedAppStarts": 1,
   "finish": 9.0,
   "steps": [
    {
     "t": 2.0,
     "check": "app.canHeat",
     "expect": "HEAT IT is available once status is flowing"
    },
    {
     "t": 2.0,
     "check": "app.presets[1].tempF == 450 && app.presets[1].hold == 12",
     "expect": "presets were read from the rig"
    },
    {
     "t": 2.0,
     "do": "heatIt"
    },
    {
     "t": 3.0,
     "check": "sim.session == 170 && app.sessionOn",
     "expect": "rig is heating and the app knows"
    },
    {
     "t": 6.0,
     "do": "cutIt"
    },
    {
     "t": 6.4,
     "check": "sim.session == 0",
     "expect": "rig stopped within 0.4 s of CUT IT"
    }
   ],
   "final": [
    {
     "rule": "events.count('STOP by app frame') == 1",
     "expect": "exactly one stop reached the rig"
    },
    {
     "rule": "!app.sessionOn",
     "expect": "app shows not heating"
    },
    {
     "rule": "log.count('(stop, session 0)') == 1",
     "expect": "no stop retry was needed"
    }
   ]
  },
  {
   "id": "naturalEndWithShow",
   "title": "natural end with light show and flash",
   "show": true,
   "allowedAppStarts": 1,
   "finish": 21.0,
   "steps": [
    {
     "t": 2.0,
     "do": "heatIt"
    },
    {
     "t": 9.0,
     "check": "sim.lightMode != 3 || sim.brightness != 50",
     "expect": "light show changed the lights"
    }
   ],
   "final": [
    {
     "rule": "events.count('STOP by its own timer') == 1",
     "expect": "the dab ran to the end on the rig's own timer"
    },
    {
     "rule": "sim.sessionStarts == 1",
     "expect": "heat never came back on"
    },
    {
     "rule": "log.has('Slow-down flash started')",
     "expect": "flash ran"
    },
    {
     "rule": "sim.lightMode == 3 && sim.brightness == 50",
     "expect": "lights were put back"
    },
    {
     "rule": "b9s.filter(f => f.bytes[10] == 170 && f.sessionWas != 0 && f.remainingWas <= 2).length == 0",
     "expect": "nothing was written in the last 2 seconds of the countdown"
    },
    {
     "rule": "stopsWhileHeating == 0",
     "expect": "nothing cut the dab short"
    },
    {
     "rule": "!log.has('SAFETY CUT') && !log.has('AWAY')",
     "expect": "no safety action fired in a normal dab"
    }
   ]
  },
  {
   "id": "raceRestartSilent",
   "title": "race: rig stops just before a light write lands (no off status seen)",
   "allowedAppStarts": 2,
   "finish": 13.0,
   "notes": "The rig's own button stops it in the instant after a 'heating' status goes out, so the app's light write echoes 'heating' and restarts heat. The app cannot prevent that one frame; it must notice and cut.",
   "steps": [
    {
     "t": 2.0,
     "do": "heatIt"
    },
    {
     "t": 8.3,
     "do": "sim.afterNextStatus",
     "args": {
      "then": [
       "sim.buttonStop"
      ]
     }
    },
    {
     "t": 8.3,
     "do": "setLightMode",
     "args": {
      "mode": 5
     }
    }
   ],
   "final": [
    {
     "rule": "sim.sessionStarts == 2",
     "expect": "the race really happened (heat was restarted by the echo)"
    },
    {
     "rule": "log.has('SAFETY CUT')",
     "expect": "the app noticed and cut"
    },
    {
     "rule": "sim.session == 0",
     "expect": "heat is off at the end"
    },
    {
     "rule": "starts.length == 2 && stops.length >= 2 && stops[1].time - starts[1].time < 1.2",
     "expect": "accidental heat lasted under 1.2 s"
    }
   ]
  },
  {
   "id": "raceRestartSeenOff",
   "title": "race: rig stops, reports off, then a light write in flight restarts it",
   "allowedAppStarts": 2,
   "finish": 13.0,
   "setup": {
    "world.writeLatency": 0.06
   },
   "steps": [
    {
     "t": 2.0,
     "do": "heatIt"
    },
    {
     "t": 8.3,
     "do": "sim.afterNextStatus",
     "args": {
      "delay": 0.03,
      "then": [
       "sim.buttonStop",
       "sim.sendStatus"
      ]
     }
    },
    {
     "t": 8.3,
     "do": "setLightMode",
     "args": {
      "mode": 5
     }
    }
   ],
   "final": [
    {
     "rule": "sim.sessionStarts == 2",
     "expect": "the race really happened (heat was restarted by the echo)"
    },
    {
     "rule": "log.has('SAFETY CUT')",
     "expect": "the app noticed and cut"
    },
    {
     "rule": "sim.session == 0",
     "expect": "heat is off at the end"
    },
    {
     "rule": "starts.length == 2 && stops.length >= 2 && stops[1].time - starts[1].time < 1.2",
     "expect": "accidental heat lasted under 1.2 s"
    }
   ]
  },
  {
   "id": "rigButtonStopDuringFlash",
   "title": "rig button stops the dab during the flash (random moment)",
   "show": true,
   "allowedAppStarts": "sim.sessionStarts",
   "finish": 14.0,
   "notes": "The stop lands at 9.0 s plus a random 0 to 0.45 s in steps of 0.05. Either no race (1 start) or a race the app cut (2 starts).",
   "steps": [
    {
     "t": 2.0,
     "do": "heatIt"
    },
    {
     "t": "9.0 + 0.05 * randomInt(0, 9)",
     "do": "sim.buttonStop"
    }
   ],
   "final": [
    {
     "rule": "sim.session == 0",
     "expect": "heat is off at the end"
    },
    {
     "rule": "sim.sessionStarts <= 1 || log.has('SAFETY CUT')",
     "expect": "accidental restart was cut"
    },
    {
     "rule": "sim.lightMode == 3 && sim.brightness == 50",
     "expect": "lights were put back"
    }
   ]
  },
  {
   "id": "leaveAppMidDab",
   "title": "leave the app mid-dab: dab finishes, heat confirmed off, app lets go, reconnects on return",
   "show": true,
   "allowedAppStarts": 1,
   "finish": 29.0,
   "setup": {
    "app.parkAfterQuiet": 4
   },
   "steps": [
    {
     "t": 2.0,
     "do": "heatIt"
    },
    {
     "t": 5.0,
     "do": "appMovedToBackground"
    },
    {
     "t": 15.0,
     "check": "stopsWhileHeating == 0",
     "expect": "the running dab was not cut"
    },
    {
     "t": 15.0,
     "check": "world.peripheral.connected",
     "expect": "still connected while the dab runs"
    },
    {
     "t": 19.0,
     "check": "events.count('STOP by its own timer') == 1",
     "expect": "the dab ran to its own end"
    },
    {
     "t": 19.0,
     "check": "log.count('SAFE OFF (stop, session 0)') == 1",
     "expect": "one stop was sent after the dab to confirm heat is off"
    },
    {
     "t": 19.0,
     "check": "sim.lightMode == 3 && sim.brightness == 50",
     "expect": "lights were put back while in the background"
    },
    {
     "t": 24.5,
     "check": "!world.peripheral.connected",
     "expect": "app let go of the rig after sitting idle"
    },
    {
     "t": 24.5,
     "check": "ble.connectionText.startsWith('Resting')",
     "expect": "status text says resting"
    },
    {
     "t": 26.0,
     "do": "appBecameActive"
    }
   ],
   "final": [
    {
     "rule": "ble.isConnected && app.canControl",
     "expect": "reconnected by itself on return"
    },
    {
     "rule": "app.awayNote != null",
     "expect": "a note tells him what happened"
    },
    {
     "rule": "sim.sessionStarts == 1",
     "expect": "heat never came back on"
    },
    {
     "rule": "stopsWhileHeating == 0",
     "expect": "the dab was never cut"
    }
   ]
  },
